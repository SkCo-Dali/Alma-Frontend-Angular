{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.{css,js,map,png,svg,ico,json,txt,webmanifest,woff,woff2}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
